#include "common_defs.hpp"
#include <aie_api/aie.hpp>
#include <aie_api/aie_adf.hpp>
#include <aie_api/utils.hpp>

void single_lstm_gate(
    adf::input_buffer<float> &__restrict input,
    adf::input_buffer<float> &__restrict state,
    adf::output_buffer<float> &__restrict output,
    // Run Time Parameters.
    const float (&weight_input)[N_LSTM_UNITS * INPUT_DIM],
    // State weight matrix is split horizontally into two because each
    // runtime parameter needs to fit a single memory module of 32KB
    // (roughly).
    const float (&weight_state_left)[N_LSTM_UNITS * N_LSTM_UNITS / 2],
    const float (&weight_state_right)[N_LSTM_UNITS * N_LSTM_UNITS / 2],
    const float (&bias)[N_LSTM_UNITS]) {
  auto inpIter = aie::cbegin_vector_circular<VECTOR_LANES>(input);
  auto recIter = aie::cbegin_vector_circular<VECTOR_LANES>(recur);
  auto wInpIter = aie::cbegin_vector<VECTOR_LANES>(weight_input);
  auto wStateLIter = aie::cbegin_vector<VECTOR_LANES>(weight_state_left);
  auto wStateRIter = aie::cbegin_vector<VECTOR_LANES>(weight_state_right);
  auto bIter = aie::cbegin(bias);
  auto outIter = aie::begin_vector<VECTOR_LANES>(output);

  aie::accumulator<accfloat, VECTOR_LANES> acc1, acc2;
  aie::vector<float, VECTOR_LANES> va, vb;
  float sum1, sum2;

  chess_prepare_for_pipelining {

    for (int i = 0; i < N_LSTM_UNITS; i++) {
      // NOTE: The reason for using two accumulators is to fill the
      // pipeline during the two idle cycles of float MACS, as
      // described in UG1079, page 54.
      acc1 = aie::zeros<accfloat, VECTOR_LANES>();
      acc2 = aie::zeros<accfloat, VECTOR_LANES>();

      // Multiply and accumulate with left half of state weight matrix.
      for (int j = 0; j < N_LSTM_UNITS / VECTOR_LANES / 4; j++) {
        va = *wStateLIter++;
        vb = *recIter++;
        acc1 = aie::mac(acc1, va, vb);
        va = *wStateLIter++;
        vb = *recIter++;
        acc2 = aie::mac(acc2, va, vb);
      }

      // Multiply and accumulate with right half of state weight matrix.
      for (int j = 0; j < N_LSTM_UNITS / VECTOR_LANES / 4; j++) {
        va = *wStateRIter++;
        vb = *recIter++;
        acc1 = aie::mac(acc1, va, vb);
        va = *wStateRIter++;
        vb = *recIter++;
        acc2 = aie::mac(acc2, va, vb);
      }

      // Mutiply and accumulate with input-weight matrix.
      for (int j = 0; j < INPUT_DIM / VECTOR_LANES; j++) {
        acc1 = aie::mac(acc1, *wInpIter++, *inpIter++);
      }

      // Sum all of the accumulator lanes and the bias.
      sum1 = aie::reduce_add(acc1.to_vector<float, VECTOR_LANES>(0));
      sum2 = aie::reduce_add(acc2.to_vector<float, VECTOR_LANES>(0));
      sum1 = aie::add(sum1, sum2);
      *outIter++ = aie::add(sum1, *bIter++);
    }
  }
}
