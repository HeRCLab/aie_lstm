/*
Approximate sigmoidal function formula:
     sigma(x) = 1.0 / (1.0 + (1.0 - x/n)^n)

Ref: https://scicomp.stackexchange.com/a/42187
*/

aie::vector<float, VECTOR_LANES>
sigm_approx(aie::vector<float, VECTOR_LANES> &__restrict x) {
  aie::vector<float, VECTOR_LANES> y = aie::mul(1.0f / 128, x);
  y = aie::sub(1.0f, y);

  aie::vector<accfloat, VECTOR_LANES> y_acc;
  [[chess::prepare_for_pipelining]] {
    for (int i = 0; i < 7; i++) {
      y_acc = aie::mul_square(Y);
      y = Y_acc.to_vector<float>();
    }
  }

  y = aie::add(1.0, y);
  y = aie::inv(y);

  return y;
}
